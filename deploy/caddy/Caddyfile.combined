# Combined host TLS — one Caddy process owns ports 80 + 443 for both apps.
#
# Default globalfotech hostnames below. To use other domains:
#   LMSOLD_PUBLIC_URL=https://admin.example.com \
#   LMS_APP_URL=https://lms.example.com \
#   INSTALL_CADDY=1 CADDY_MODE=combined ./deploy.sh
# That writes deploy/caddy/Caddyfile.combined.generated and installs it.
# Site names MUST match DNS + FRONTEND_URL (admin) / APP_URL (lms-web).
#
# Use this when lms-web and lmsold share the same EC2 instance. Do NOT run a
# second reverse proxy (or docker-proxy) bound to :80/:443 alongside Caddy.
#
#   sudo cp /path/to/lmsold/deploy/caddy/Caddyfile.combined /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Targets (loopback binds recommended in each compose file):
#   lms.globalfotech.net   → lms-web container     :3000
#   admin.globalfotech.net → lmsold combined app   :3001

lms.globalfotech.net {
	encode gzip
	reverse_proxy 127.0.0.1:3000
}

admin.globalfotech.net {
	encode gzip
	reverse_proxy 127.0.0.1:3001
}
