# LMSOld admin — Caddy reverse proxy (preferred)
#
# Install Caddy on the EC2 host, point DNS A record for admin.digitechpro.in at
# this server, open security group ports 80 + 443, then either:
#
#   # Admin only (if lms-web uses a separate proxy host):
#   sudo cp deploy/caddy/Caddyfile /etc/caddy/Caddyfile
#
#   # Shared host with lms.digitechpro.in — use ONE Caddyfile that owns :80/:443:
#   sudo cp deploy/caddy/Caddyfile.combined /etc/caddy/Caddyfile
#
#   sudo systemctl enable --now caddy
#   sudo systemctl reload caddy
#
# Caddy obtains and renews Let's Encrypt certificates automatically.
#
# Upstream (loopback bind recommended in compose):
#   Combined SPA + API → 127.0.0.1:3001 (lmsold-app)
#
# Same-origin /api keeps CORS simple (CRA live BASE_URL is "/api/").

admin.digitechpro.in {
	encode gzip
	reverse_proxy 127.0.0.1:3001
}
