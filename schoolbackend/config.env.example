# Copy to config.env and fill in real values. Never commit config.env.
# Local Docker Mongo — requires root user + authSource=admin
# Pattern: mongodb://USER:PASS@127.0.0.1:27017/nwis?authSource=admin
MONGO_URI=mongodb://USER:PASS@127.0.0.1:27017/nwis?authSource=admin
PORT = 3001
FRONTEND_URL = http://localhost:80
ACCESS_TOKEN_SECRET = change-me-access-token-secret
NODE_ENV = development
ACCESS_EXPIRES_IN = 30d
REFRESH_TOKEN_SECRET = change-me-refresh-token-secret
REFRESH_EXPIRES_IN = 30d
ACCESS_COOKIE_EXPIRES_IN = 30
REFRESH_COOKIE_EXPIRES_IN = 30
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USERNAME=your-mailtrap-username
MAILTRAP_PASSWORD=your-mailtrap-password
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=noreply@example.com

# Gmail SMTP Configuration (for real email sending)
# GMAIL_USER=your-email@gmail.com
# GMAIL_PASSWORD=your-app-password
USE_GMAIL_SMTP=false

# AWS S3 Configuration (for file uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_REGION=eu-north-1
AWS_S3_BUCKET=your-s3-bucket-name
