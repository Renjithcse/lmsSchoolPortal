# Copy to .env on the server only. Never commit .env.
# Compose loads this via env_file on lmsold-app. Production must use this
# runtime `.env` only — do not rely on schoolbackend/config.env (excluded
# from the image via .dockerignore; server.js dotenv is for local/dev).
#
# Single-container deploy: SPA + API on :3001. Caddy proxies your admin
# host → 127.0.0.1:3001 (same-origin for the CRA).
#
# --- Changing the public domain (configurable) ---
# Set FRONTEND_URL to your real public origin (scheme+host). Examples:
#   FRONTEND_URL=https://admin.example.com
#   FRONTEND_URL=https://admin.globalfotech.net
# Canonical deploy var (used by ./deploy.sh, not required in this file):
#   LMSOLD_PUBLIC_URL=https://admin.example.com
# Host-only shorthand:
#   ADMIN_DOMAIN=admin.example.com
# Keep FRONTEND_URL equal to that origin (CORS + Secure cookies).
# Quick sync on deploy:
#   LMSOLD_PUBLIC_URL=https://admin.example.com SYNC_FRONTEND_URL=1 ./deploy.sh
# Defaults (globalfotech): https://admin.globalfotech.net
# Shared host with lms-web — regenerate combined Caddy:
#   LMS_APP_URL=https://lms.globalfotech.net \
#   LMSOLD_PUBLIC_URL=https://admin.globalfotech.net \
#   INSTALL_CADDY=1 CADDY_MODE=combined ./deploy.sh

# --- required ---
NODE_ENV=production
PORT=3001
# Public origin (scheme+host). Must be https when TLS terminates on Caddy/nginx.
# Drives CORS allowlist + Secure cookies when NODE_ENV=production.
# Must match the browser URL / LMSOLD_PUBLIC_URL / Caddy site name.
# Change this when the admin domain changes — do not hardcode a single host.
FRONTEND_URL=https://admin.example.com

# Mongo — REQUIRED. Compose injects this into the container via env_file.
# Prefer the Docker network hostname (Mongo service on external network lmsold_net):
#   mongodb://USER:PASS@mongodb:27017/DBNAME?authSource=admin
# Password with @ must be URL-encoded as %40 (e.g. Admin@2025 → Admin%402025).
# authSource=admin for Docker root users.
#
# Hostname patterns (pick one):
#   mongodb              → Mongo container on lmsold_net (recommended)
#   host.docker.internal → mongod on the Docker host (compose extra_hosts)
#   *.mongodb.net        → Atlas (mongodb+srv://...)
# NEVER 127.0.0.1 or localhost inside the app container — that is the
# container itself, not the host / Mongo service (causes ECONNREFUSED).
MONGO_URI=mongodb://admin:CHANGE_ME@mongodb:27017/nwis?authSource=admin
# Example with encoded @:
# MONGO_URI=mongodb://admin:Admin%402025@mongodb:27017/nwis?authSource=admin
#
# Alternative: host-published Mongo (not on lmsold_net):
# MONGO_URI=mongodb://USER:PASS@host.docker.internal:27017/nwis?authSource=admin

ACCESS_TOKEN_SECRET=change-me-long-random
REFRESH_TOKEN_SECRET=change-me-long-random
ACCESS_EXPIRES_IN=30d
REFRESH_EXPIRES_IN=30d
ACCESS_COOKIE_EXPIRES_IN=30
REFRESH_COOKIE_EXPIRES_IN=30

# --- email (pick what you use) ---
EMAIL_FROM=noreply@example.com
BREVO_API_KEY=
MAILTRAP_HOST=
MAILTRAP_PORT=587
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
USE_GMAIL_SMTP=false
# GMAIL_USER=
# GMAIL_PASSWORD=

# --- optional S3 uploads ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_S3_BUCKET=

# --- optional seeder flags ---
# SEED_COUNTRIES=false
